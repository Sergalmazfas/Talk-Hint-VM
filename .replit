modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["node", "./dist/index.cjs"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[workflows.workflow.metadata]
isValidation = true

[agent]
mockupState = "FULLSTACK"
[userenv]

[userenv.shared]
VAPID_PUBLIC_KEY = "BKG5nJon2zwG1nRd0TnryWcRDNa5htAQsHlJPoa_U9c20g0KTvGB87IOon1iMc5l7lNnxT30wXMsx60VQgzecKs"
VAPID_SUBJECT = "mailto:support@talkhint.me"
APNS_BUNDLE_ID = "app.talkhint"

[userenv.development]
DISABLE_TWILIO_SIGNATURE_CHECK = "true"

[userenv.production]
DISABLE_TWILIO_SIGNATURE_CHECK = "true"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
