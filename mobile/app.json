{
  "expo": {
    "name": "TalkHint",
    "slug": "talkhint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "talkhint",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talkhint.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TalkHint uses your microphone to transcribe your calls and provide real-time AI suggestions.",
        "NSCameraUsageDescription": "TalkHint does not use the camera.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio", "voip"],
        "LSApplicationQueriesSchemes": ["talkhint"]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.talkhint.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "TalkHint uses your microphone to transcribe your calls and provide real-time AI suggestions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      },
      "privacyPolicyUrl": "https://talkhint.app/privacy",
      "supportUrl": "https://talkhint.app/support"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/REPLACE_WITH_YOUR_EAS_PROJECT_ID"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
